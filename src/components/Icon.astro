---
/**
 * Inline line/solid icons, geometry ported 1:1 from the app's BrainDropIcons.kt
 * (24x24 coordinate space, round joins). Colour and stroke width are passed by
 * the caller so one icon can match every context it appears in.
 */
type IconName =
  | "chevron-right"
  | "chevron-left"
  | "play"
  | "flame"
  | "search"
  | "close"
  | "check"
  | "cross"
  | "list"
  | "person"
  | "bar-chart"
  | "cards";

interface Props {
  name: IconName;
  size?: number;
  /** stroke colour for line icons, fill colour for solid icons */
  color?: string;
  /** stroke width for line icons */
  weight?: number;
  class?: string;
}

const { name, size = 24, color = "currentColor", weight = 2.2, class: cls } = Astro.props;

const stroke = {
  fill: "none",
  stroke: color,
  "stroke-width": weight,
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
---

{
  name === "chevron-right" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <path d="M9 4 L15 12 L9 20" />
    </svg>
  )
}
{
  name === "chevron-left" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <path d="M15 4 L9 12 L15 20" />
    </svg>
  )
}
{
  name === "play" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} fill={color}>
      <path d="M4 2.6 L15.6 12 L4 21.4 Z" />
    </svg>
  )
}
{
  name === "flame" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} fill={color}>
      <path d="M12 2.5 C13.5 6 17.5 8.3 17.5 13 C17.5 17.6 14.5 21 11.3 21 C7.6 21 5.2 18.2 5.6 14.4 C5.9 11.6 8 11 8.2 13.6 C8.3 14.8 9 15.1 9.5 14.2 C10.4 12.5 8.7 10.6 9.6 6.8 C10.1 4.7 11.2 3.3 12 2.5 Z" />
    </svg>
  )
}
{
  name === "search" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <circle cx="10.2" cy="10.2" r="6.6" />
      <path d="M15 15 L20.2 20.2" />
    </svg>
  )
}
{
  (name === "close" || name === "cross") && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <path d="M5 5 L19 19" />
      <path d="M19 5 L5 19" />
    </svg>
  )
}
{
  name === "check" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <path d="M4 12.5 L9.5 18 L20 5.5" />
    </svg>
  )
}
{
  name === "list" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <path d="M4.5 6 L19.5 6" />
      <path d="M4.5 12 L19.5 12" />
      <path d="M4.5 18 L19.5 18" />
    </svg>
  )
}
{
  name === "person" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <circle cx="12" cy="7.6" r="3.6" />
      <path d="M4.5 20 C4.5 15 8 13 12 13 C16 13 19.5 15 19.5 20" />
    </svg>
  )
}
{
  name === "bar-chart" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} {...stroke}>
      <path d="M5 19 L5 12" />
      <path d="M12 19 L12 5" />
      <path d="M19 19 L19 9" />
    </svg>
  )
}
{
  name === "cards" && (
    <svg viewBox="0 0 24 24" width={size} height={size} class={cls} fill="none" stroke={color} stroke-width={weight} stroke-linejoin="round">
      <rect x="6.5" y="3" width="14" height="14" rx="3" stroke="rgba(43,95,217,0.55)" />
      <rect x="3.5" y="7" width="14" height="14" rx="3" />
    </svg>
  )
}
