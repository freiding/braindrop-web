---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PLAY_URL } from "../consts";
---

<BaseLayout title="Страница не найдена" path="/404" description="Страница не найдена.">
  <div class="page nf">
    <div class="nf__inner">
      <a href="/" aria-label="BrainDrop — на главную">
        <img
          class="nf__logo"
          src="/braindrop-lockup.svg"
          alt="BrainDrop"
          width="133"
          height="40"
        />
      </a>
      <p class="nf__code mono-label">ОШИБКА 404</p>
      <h1 class="nf__title">Такой страницы нет</h1>
      <p class="nf__text">
        Ссылка устарела или адрес набран с ошибкой. Вернитесь на главную или
        откройте приложение в Google Play.
      </p>
      <div class="nf__actions">
        <a href="/" class="btn btn--primary">На главную</a>
        <a href={PLAY_URL} class="nf__link" target="_blank" rel="noopener">
          Открыть в Google Play →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nf__inner {
    max-width: 460px;
    padding: 80px 0 96px;
    text-align: center;
  }
  .nf__logo {
    height: 40px;
    width: auto;
    margin: 0 auto 40px;
  }
  .nf__code {
    margin-bottom: 14px;
  }
  .nf__title {
    font-size: 40px;
    line-height: 46px;
    font-weight: 800;
    letter-spacing: -1.2px;
  }
  .nf__text {
    margin-top: 16px;
    font-size: 16px;
    line-height: 25px;
    font-weight: 500;
    color: var(--ink-600);
    text-wrap: pretty;
  }
  .nf__actions {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .nf__link {
    font-size: 13.5px;
    font-weight: 600;
  }

  @media (max-width: 520px) {
    .nf__title {
      font-size: 30px;
      line-height: 36px;
      letter-spacing: -0.8px;
    }
  }
</style>
